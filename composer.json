{
	"name": "flarum-lang/turkish",
	"description": "Turkish Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/turkish",
	"license": "MIT",
	"authors": [
		{
			"name": "tolgaaaltas",
			"homepage": "https://github.com/tolgaaaltas",
			"role": "Maintainer"
		},
		{
			"name": "huseyinfiliz",
			"homepage": "https://github.com/huseyinfiliz",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/turkish/issues",
		"forum": "https://discuss.flarum.org/d/21356",
		"source": "https://github.com/flarum-lang/turkish"
